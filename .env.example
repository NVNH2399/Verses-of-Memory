# Neon Postgres connection strings.
# Lấy cả 2 loại này trong Neon Dashboard > Connection Details:
#
# DATABASE_URL: dùng connection string có "-pooler" trong hostname (Pooled connection).
#   Dùng cho app chạy bình thường (npm run dev / production).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/verses_of_memory?sslmode=require"

# DIRECT_URL: dùng connection string KHÔNG có "-pooler" (Direct connection).
#   Bắt buộc cho `npx prisma migrate dev` / `npx prisma migrate deploy` —
#   Prisma Migrate cần kết nối trực tiếp, không qua PgBouncer.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/verses_of_memory?sslmode=require"

# NextAuth — dùng cho đăng nhập/đăng ký + phân quyền trang quản trị.
# Tạo secret ngẫu nhiên: `openssl rand -base64 32`
NEXTAUTH_SECRET="thay-bang-chuoi-ngau-nhien-du-dai"
# URL của app khi chạy local — đổi thành domain thật khi deploy Vercel.
NEXTAUTH_URL="http://localhost:3000"
